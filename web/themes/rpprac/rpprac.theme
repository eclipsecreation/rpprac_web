<?php

/**
 * @file
 * Theme hooks for the RPPRAC theme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_theme().
 */
function rpprac_theme(): array {
  $common_variables = [
    'content' => NULL,
    'attributes' => NULL,
    'rpprac_has_section_image' => FALSE,
    'rpprac_hero_background_style' => NULL,
    'rpprac_hero_has_video' => FALSE,
    'rpprac_hero_background_video_url' => NULL,
    'rpprac_hero_video_poster_url' => NULL,
  ];

  return [
    'rpprac_home_hero' => [
      'variables' => $common_variables,
      'template' => 'block--block-content--type--accueil-hero',
      'path' => \Drupal::service('extension.list.theme')->getPath('rpprac') . '/templates/block',
    ],
    'rpprac_home_positionnement' => [
      'variables' => $common_variables,
      'template' => 'block--block-content--type--accueil-positionnement',
      'path' => \Drupal::service('extension.list.theme')->getPath('rpprac') . '/templates/block',
    ],
    'rpprac_home_cibles' => [
      'variables' => $common_variables,
      'template' => 'block--block-content--type--accueil-cibles',
      'path' => \Drupal::service('extension.list.theme')->getPath('rpprac') . '/templates/block',
    ],
    'rpprac_home_differenciation' => [
      'variables' => $common_variables,
      'template' => 'block--block-content--type--accueil-differenciation',
      'path' => \Drupal::service('extension.list.theme')->getPath('rpprac') . '/templates/block',
    ],
    'rpprac_home_methode' => [
      'variables' => $common_variables,
      'template' => 'block--block-content--type--accueil-methode',
      'path' => \Drupal::service('extension.list.theme')->getPath('rpprac') . '/templates/block',
    ],
    'rpprac_home_ancrage_local' => [
      'variables' => $common_variables,
      'template' => 'block--block-content--type--accueil-ancrage-local',
      'path' => \Drupal::service('extension.list.theme')->getPath('rpprac') . '/templates/block',
    ],
    'rpprac_home_contact_final' => [
      'variables' => $common_variables,
      'template' => 'block--block-content--type--accueil-contact-final',
      'path' => \Drupal::service('extension.list.theme')->getPath('rpprac') . '/templates/block',
    ],
  ];
}

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function rpprac_form_system_theme_settings_alter(&$form, FormStateInterface $form_state, $form_id = NULL) {
  unset($form['theme_mode_details']);
  unset($form['body_details']);
  unset($form['nav_details']);
  unset($form['footer_details']);

  // Social links settings.
  $form['rpprac_social_links'] = [
    '#type' => 'details',
    '#title' => t('Social links'),
    '#open' => FALSE,
  ];

  $form['rpprac_social_links']['tiktok_url'] = [
    '#type' => 'url',
    '#title' => t('TikTok URL'),
    '#default_value' => theme_get_setting('tiktok_url'),
    '#description' => t('Full URL to the organisation TikTok profile.'),
  ];

  $form['rpprac_social_links']['youtube_url'] = [
    '#type' => 'url',
    '#title' => t('YouTube URL'),
    '#default_value' => theme_get_setting('youtube_url'),
  ];

  $form['rpprac_social_links']['facebook_url'] = [
    '#type' => 'url',
    '#title' => t('Facebook URL'),
    '#default_value' => theme_get_setting('facebook_url'),
  ];

  $form['rpprac_social_links']['x_url'] = [
    '#type' => 'url',
    '#title' => t('X (Twitter) URL'),
    '#default_value' => theme_get_setting('x_url'),
  ];

  $form['rpprac_social_links']['instagram_url'] = [
    '#type' => 'url',
    '#title' => t('Instagram URL'),
    '#default_value' => theme_get_setting('instagram_url'),
  ];

  $form['rpprac_social_links']['snapchat_url'] = [
    '#type' => 'url',
    '#title' => t('Snapchat URL'),
    '#default_value' => theme_get_setting('snapchat_url'),
  ];

  $form['rpprac_social_links']['rss_url'] = [
    '#type' => 'url',
    '#title' => t('RSS feed URL'),
    '#default_value' => theme_get_setting('rss_url'),
  ];

  $form['rpprac_social_links']['whatsapp_url'] = [
    '#type' => 'url',
    '#title' => t('WhatsApp URL'),
    '#default_value' => theme_get_setting('whatsapp_url'),
    '#description' => t('Use the direct chat link (https://wa.me/...) or group invite URL.'),
  ];
}

/**
 * Applies hero-specific template variables for homepage hero content.
 */
function rpprac_apply_hero_block_content_variables(array &$variables, \Drupal\block_content\BlockContentInterface $block_content): void {
  if ($block_content->bundle() !== 'accueil_hero') {
    return;
  }

  $variables['rpprac_hero_background_mode'] = 'image';
  if (!$block_content->get('field_hero_background_mode')->isEmpty()) {
    $variables['rpprac_hero_background_mode'] = $block_content->get('field_hero_background_mode')->value;
  }

  if (!$block_content->get('field_section_image')->isEmpty()) {
    $image = $block_content->get('field_section_image')->entity;
    if ($image) {
      $image_url = \Drupal::service('file_url_generator')->generateString($image->getFileUri());
      $variables['rpprac_hero_background_image_url'] = $image_url;
      $variables['rpprac_hero_background_style'] = '--rpprac-hero-background: url("' . $image_url . '");';
      $variables['rpprac_hero_video_poster_url'] = $image_url;
    }
  }

  if ($variables['rpprac_hero_background_mode'] !== 'video') {
    return;
  }

  if (!$block_content->get('field_hero_background_video')->isEmpty()) {
    $video = $block_content->get('field_hero_background_video')->entity;
    if ($video) {
      $variables['rpprac_hero_background_video_url'] = \Drupal::service('file_url_generator')->generateString($video->getFileUri());
      $variables['rpprac_hero_has_video'] = TRUE;
    }
  }
}

/**
 * Applies hero-specific template variables for editorial page nodes.
 */
function rpprac_apply_page_hero_variables(array &$variables, \Drupal\node\NodeInterface $node): void {
  if (!$node->hasField('field_hero_title') || !$node->hasField('field_hero_text') || !$node->hasField('field_hero_image')) {
    return;
  }

  $variables['rpprac_page_has_hero'] = FALSE;
  $variables['rpprac_hero_background_mode'] = 'image';

  $hero_title = '';
  if ($node->hasField('field_hero_title') && !$node->get('field_hero_title')->isEmpty()) {
    $hero_title = trim((string) $node->get('field_hero_title')->value);
  }
  $variables['rpprac_page_hero_title'] = $hero_title !== '' ? $hero_title : $node->label();

  if ($node->hasField('field_hero_background_mode') && !$node->get('field_hero_background_mode')->isEmpty()) {
    $variables['rpprac_hero_background_mode'] = $node->get('field_hero_background_mode')->value;
  }

  if ($node->hasField('field_hero_image') && !$node->get('field_hero_image')->isEmpty()) {
    $image = $node->get('field_hero_image')->entity;
    if ($image) {
      $image_url = \Drupal::service('file_url_generator')->generateString($image->getFileUri());
      $variables['rpprac_hero_background_image_url'] = $image_url;
      $variables['rpprac_hero_background_style'] = '--rpprac-hero-background: url("' . $image_url . '");';
      $variables['rpprac_hero_video_poster_url'] = $image_url;
      $variables['rpprac_page_has_hero'] = TRUE;
    }
  }

  if ($variables['rpprac_hero_background_mode'] === 'video' && $node->hasField('field_hero_background_video') && !$node->get('field_hero_background_video')->isEmpty()) {
    $video = $node->get('field_hero_background_video')->entity;
    if ($video) {
      $variables['rpprac_hero_background_video_url'] = \Drupal::service('file_url_generator')->generateString($video->getFileUri());
      $variables['rpprac_hero_has_video'] = TRUE;
      $variables['rpprac_page_has_hero'] = TRUE;
    }
  }

  if ($variables['rpprac_page_hero_title'] !== '') {
    $variables['rpprac_page_has_hero'] = TRUE;
  }
}

/**
 * Loads the first available custom block for a homepage singleton bundle.
 */
function rpprac_load_homepage_singleton(string $bundle): array {
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $candidates = $storage->loadByProperties([
    'type' => $bundle,
  ]);

  if ($candidates === []) {
    return [];
  }

  uasort($candidates, static function ($left, $right): int {
    return ($left->id() ?? 0) <=> ($right->id() ?? 0);
  });

  $selected = NULL;
  foreach ($candidates as $candidate) {
    if (!$candidate instanceof \Drupal\block_content\BlockContentInterface) {
      continue;
    }

    if ((bool) $candidate->get('reusable')->value) {
      $selected = $candidate;
      break;
    }

    if ($selected === NULL) {
      $selected = $candidate;
    }
  }

  if (!$selected instanceof \Drupal\block_content\BlockContentInterface) {
    return [];
  }

  $theme_map = [
    'accueil_hero' => 'rpprac_home_hero',
    'accueil_positionnement' => 'rpprac_home_positionnement',
    'accueil_cibles' => 'rpprac_home_cibles',
    'accueil_differenciation' => 'rpprac_home_differenciation',
    'accueil_methode' => 'rpprac_home_methode',
    'accueil_ancrage_local' => 'rpprac_home_ancrage_local',
    'accueil_contact_final' => 'rpprac_home_contact_final',
  ];

  if (!isset($theme_map[$bundle])) {
    return [];
  }

  $content = \Drupal::entityTypeManager()
    ->getViewBuilder('block_content')
    ->view($selected, 'full');

  $build = [
    '#theme' => $theme_map[$bundle],
    '#content' => $content,
    '#attributes' => new Attribute(),
    '#rpprac_has_section_image' => $selected->hasField('field_section_image') && !$selected->get('field_section_image')->isEmpty(),
    '#cache' => [
      'tags' => $selected->getCacheTags(),
      'contexts' => $selected->getCacheContexts(),
      'max-age' => $selected->getCacheMaxAge(),
    ],
  ];

  if ($bundle === 'accueil_hero') {
    $hero_variables = [];
    rpprac_apply_hero_block_content_variables($hero_variables, $selected);
    foreach ($hero_variables as $key => $value) {
      $build['#' . $key] = $value;
    }
  }

  return $build;
}

/**
 * Implements hook_preprocess_html().
 */
function rpprac_preprocess_html(array &$variables) {
  $variables['b5_body_schema'] = '';
  $variables['b5_body_bg_schema'] = '';
  $variables['b5_theme_mode'] = 'light';

  // Force the theme to use a light colour scheme by setting the
  // `data-bs-theme` attribute on the root html element. This neutralises
  // Bootstrap's automatic dark/light switching.
  if (!isset($variables['attributes']) || !($variables['attributes'] instanceof Attribute)) {
    $variables['attributes'] = new Attribute();
  }
  $variables['attributes']->setAttribute('data-bs-theme', 'light');

  // Set inline CSS variables on the root element to override Bootstrap's
  // built-in dark/light variables (for example `--bs-dark-rgb`). Placing
  // these variables inline ensures they take precedence even if the
  // Bootstrap stylesheet is loaded after the theme stylesheet.
  $attrs_array = $variables['attributes']->toArray();
  $existing_style = $attrs_array['style'] ?? '';
  $override_vars = '--bs-dark-rgb: 5,5,5; --bs-body-bg: #ffffff; --bs-body-color: #0b0b0d; --bs-bg-opacity: 1;';
  $variables['attributes']->setAttribute('style', trim(($existing_style ? $existing_style . ' ' : '') . $override_vars));

  $theme_path = \Drupal::service('extension.list.theme')->getPath('rpprac');
  $base_path = \Drupal::request()->getBasePath();
  $variables['rpprac_favicon_path'] = $base_path . '/' . $theme_path . '/logo.png';
  $variables['rpprac_favicon_fallback_path'] = $base_path . '/' . $theme_path . '/logo.png';
}

/**
 * Implements hook_preprocess_page().
 */
function rpprac_preprocess_page(array &$variables) {
  $variables['b5_top_container'] = 'container';
  $variables['b5_navbar_schema'] = 'light';
  $variables['b5_navbar_bg_schema'] = 'none';
  $variables['b5_footer_schema'] = 'dark';
  // Do not add Bootstrap `bg-*` utilities to the footer so our
  // `.rpprac-footer` rules control the background. This prevents the
  // `.bg-dark` utility from superseding theme styles.
  $variables['b5_footer_bg_schema'] = 'none';

  // Provide an attributes object for the footer so we can inject inline
  // styles with the highest specificity if Bootstrap utilities still win.
  if (!isset($variables['footer_attributes']) || !($variables['footer_attributes'] instanceof Attribute)) {
    $variables['footer_attributes'] = new Attribute();
  }
  $variables['footer_attributes']->setAttribute('style', 'background-color: var(--rpprac-footer-bg) !important; color: var(--rpprac-footer-text) !important;');

  // Attach social links library so styles are available when links are rendered.
  $variables['#attached']['library'][] = 'rpprac/social-links';

  // Provide social links from theme settings to templates.
  $theme_path = \Drupal::service('extension.list.theme')->getPath('rpprac');
  $base_path = \Drupal::request()->getBasePath();
  $social_keys = ['tiktok', 'youtube', 'facebook', 'instagram', 'snapchat', 'rss', 'whatsapp'];
  // Add X (Twitter) key.
  $social_keys[] = 'x';
  $social_links = [];
  foreach ($social_keys as $key) {
    $setting = theme_get_setting($key . '_url');
    if (!empty($setting)) {
      $social_links[$key] = $setting;
    }
  }

  $variables['rpprac_social_links'] = $social_links;
  $variables['rpprac_theme_path'] = $theme_path;
  $variables['rpprac_base_path'] = $base_path;

  $variables['rpprac_is_block_demo'] = \Drupal::routeMatch()->getRouteName() === 'block.admin_demo';
  $variables['rpprac_page_has_editorial_hero'] = FALSE;

  $variables['rpprac_home_hero'] = [];
  $variables['rpprac_home_positioning'] = [];
  $variables['rpprac_home_targets'] = [];
  $variables['rpprac_home_differentiation'] = [];
  $variables['rpprac_home_method'] = [];
  $variables['rpprac_home_local'] = [];
  $variables['rpprac_home_contact'] = [];

  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof \Drupal\node\NodeInterface && $route_node->bundle() === 'page') {
    $variables['rpprac_page_has_editorial_hero'] = TRUE;
    unset($variables['page']['content']['rpprac_page_title']);
  }

  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  $variables['rpprac_home_hero'] = rpprac_load_homepage_singleton('accueil_hero');
  $variables['rpprac_home_positioning'] = rpprac_load_homepage_singleton('accueil_positionnement');
  $variables['rpprac_home_targets'] = rpprac_load_homepage_singleton('accueil_cibles');
  $variables['rpprac_home_differentiation'] = rpprac_load_homepage_singleton('accueil_differenciation');
  $variables['rpprac_home_method'] = rpprac_load_homepage_singleton('accueil_methode');
  $variables['rpprac_home_local'] = rpprac_load_homepage_singleton('accueil_ancrage_local');
  $variables['rpprac_home_contact'] = rpprac_load_homepage_singleton('accueil_contact_final');
}

/**
 * Implements hook_preprocess_block().
 */
function rpprac_preprocess_block(array &$variables) {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('rpprac');
  $base_path = \Drupal::request()->getBasePath();

  if (($variables['plugin_id'] ?? '') === 'system_branding_block') {
    $variables['site_logo'] = $base_path . '/' . $theme_path . '/logo.png';
    $variables['rpprac_logo_path'] = $variables['site_logo'];
  }

  $block_content = $variables['elements']['content']['#block_content'] ?? NULL;
  if (!$block_content instanceof \Drupal\block_content\BlockContentInterface) {
    return;
  }

  rpprac_apply_hero_block_content_variables($variables, $block_content);
}

/**
 * Implements hook_preprocess_block_content().
 */
function rpprac_preprocess_block_content(array &$variables) {
  $block_content = $variables['elements']['#block_content'] ?? NULL;
  if (!$block_content instanceof \Drupal\block_content\BlockContentInterface) {
    return;
  }

  rpprac_apply_hero_block_content_variables($variables, $block_content);
}

/**
 * Implements hook_preprocess_node().
 */
function rpprac_preprocess_node(array &$variables) {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  rpprac_apply_page_hero_variables($variables, $node);
}

/**
 * Implements hook_preprocess_paragraph().
 */
function rpprac_preprocess_paragraph(array &$variables) {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof \Drupal\paragraphs\ParagraphInterface) {
    return;
  }

  if ($paragraph->bundle() === 'section_item') {
    $variables['rpprac_has_section_item_image'] = $paragraph->hasField('field_item_image') && !$paragraph->get('field_item_image')->isEmpty();
    $variables['rpprac_has_section_item_links'] = $paragraph->hasField('field_item_links') && !$paragraph->get('field_item_links')->isEmpty();
    return;
  }

  if ($paragraph->bundle() !== 'view_embed_section') {
    return;
  }

  $variables['rpprac_has_embedded_view'] = FALSE;
  $variables['rpprac_embedded_view'] = [];

  $view_id = '';
  $display_id = 'block_1';

  if ($paragraph->hasField('field_view_selector') && !$paragraph->get('field_view_selector')->isEmpty()) {
    $selected_view = trim((string) $paragraph->get('field_view_selector')->value);
    if ($selected_view !== '') {
      [$view_id, $display_id] = array_pad(explode(':', $selected_view, 2), 2, 'block_1');
      $view_id = trim($view_id);
      $display_id = trim($display_id) !== '' ? trim($display_id) : 'block_1';
    }
  }

  if ($view_id === '' && $paragraph->hasField('field_view_id')) {
    $view_id = trim((string) $paragraph->get('field_view_id')->value);
  }

  if (($display_id === '' || $display_id === 'block_1') && $paragraph->hasField('field_view_display_id') && !$paragraph->get('field_view_display_id')->isEmpty()) {
    $legacy_display_id = trim((string) $paragraph->get('field_view_display_id')->value);
    if ($legacy_display_id !== '') {
      $display_id = $legacy_display_id;
    }
  }

  if ($view_id === '' || !function_exists('views_embed_view')) {
    return;
  }

  $embedded_view = views_embed_view($view_id, $display_id);
  if (!is_array($embedded_view) || $embedded_view === []) {
    return;
  }

  $variables['rpprac_embedded_view'] = $embedded_view;
  $variables['rpprac_has_embedded_view'] = TRUE;
}

/**
 * Implements hook_preprocess_HOOK() for region templates.
 *
 * Strip any Bootstrap `bg-*` utility classes from the footer region so
 * theme styles (`.rpprac-footer`) always control the background.
 */
function rpprac_preprocess_region(array &$variables) {
  if (!isset($variables['region']) || $variables['region'] !== 'footer') {
    return;
  }

  if (!isset($variables['attributes']) || !($variables['attributes'] instanceof Attribute)) {
    return;
  }

  $attrs_array = $variables['attributes']->toArray();
  $classes = $attrs_array['class'] ?? [];
  if (!is_array($classes)) {
    $classes = preg_split('/\s+/', trim((string) $classes));
  }

  $filtered = array_values(array_filter($classes, static function ($c) {
    return strpos($c, 'bg-') !== 0;
  }));

  $variables['attributes']->setAttribute('class', $filtered);
}

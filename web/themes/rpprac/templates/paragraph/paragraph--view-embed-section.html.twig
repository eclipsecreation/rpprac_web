{#
/**
 * @file
 * Theme override for page sections embedding a Views block display.
 */
#}
{% if rpprac_has_embedded_view %}
  <section{{ attributes.addClass('rpprac-view-section') }}>
    {% set section_title = content.field_item_title|render|striptags|trim %}
    {% if section_title != '' %}
      <h2 class="rpprac-view-section__title">{{ content.field_item_title }}</h2>
    {% endif %}

    <div class="rpprac-view-section__content">
      {{ rpprac_embedded_view }}
    </div>
  </section>
{% endif %}
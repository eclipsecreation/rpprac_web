{#
/**
 * @file
 * Theme override for the front page.
 */
#}
{%
set nav_classes = 'navbar navbar-expand-lg border-bottom' ~
  (b5_navbar_schema != 'none' ? " navbar-#{b5_navbar_schema}" : ' ') ~
  (b5_navbar_schema != 'none' ? (b5_navbar_schema == 'dark' ? ' text-light' : ' text-dark' ) : ' ') ~
  (b5_navbar_bg_schema != 'none' ? " bg-#{b5_navbar_bg_schema}" : ' bg-white ')
%}

{%
set footer_classes = 'rpprac-footer mt-auto py-4' ~
  (b5_footer_schema != 'none' ? " footer-#{b5_footer_schema}" : ' ') ~
  (b5_footer_schema != 'none' ? (b5_footer_schema == 'dark' ? ' text-light' : ' text-dark' ) : ' text-dark ')
%}

<div id="top" class="rpprac-page rpprac-front-page">
  <header role="banner">
    {% if page.header %}
      <div class="rpprac-header-top py-2">
        <div class="{{ b5_top_container }}">
          {{ page.header }}
        </div>
      </div>
    {% endif %}

    {% if page.nav_branding or page.nav_main or page.nav_additional %}
      <nav class="{{ nav_classes }}">
        <div class="{{ b5_top_container }} d-flex align-items-center">
          {{ page.nav_branding }}

          {% if page.nav_main or page.nav_additional %}
            <button class="navbar-toggler collapsed ms-auto" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-md-end" id="navbarSupportedContent">
              {{ page.nav_main }}
              {% if rpprac_header_ctas %}
                <div class="rpprac-header-ctas">
                  {% for cta in rpprac_header_ctas %}
                    <a class="rpprac-header-cta rpprac-header-cta--{{ cta.modifier }}" href="{{ cta.url }}">{{ cta.label }}</a>
                  {% endfor %}
                </div>
              {% endif %}
              {{ page.nav_additional }}
            </div>
          {% endif %}
        </div>
      </nav>
    {% endif %}
  </header>

  <main role="main" class="rpprac-main rpprac-home-main">
    <a id="main-content" tabindex="-1"></a>

    {% if page.breadcrumb %}
      <div class="{{ b5_top_container }} rpprac-front-breadcrumb">
        {{ page.breadcrumb }}
      </div>
    {% endif %}

    {% if rpprac_home_hero or page.home_hero %}
      <section class="rpprac-home-section rpprac-home-section--hero">
        <div class="{{ b5_top_container }}">
          {{ rpprac_home_hero ?: page.home_hero }}
        </div>
      </section>
    {% endif %}

    {% if page.home_highlights %}
      <section class="rpprac-home-section rpprac-home-section--highlights">
        <div class="{{ b5_top_container }}">
          {{ page.home_highlights }}
        </div>
      </section>
    {% endif %}

    {% if rpprac_home_positioning or page.home_positioning %}
      <section class="rpprac-home-section rpprac-home-section--positioning">
        <div class="{{ b5_top_container }}">
          {{ rpprac_home_positioning ?: page.home_positioning }}
        </div>
      </section>
    {% endif %}

    {% if rpprac_home_targets or page.home_targets %}
      <section class="rpprac-home-section rpprac-home-section--targets">
        <div class="{{ b5_top_container }}">
          {{ rpprac_home_targets ?: page.home_targets }}
        </div>
      </section>
    {% endif %}

    {% if rpprac_home_differentiation or page.home_differentiation %}
      <section class="rpprac-home-section rpprac-home-section--differentiation">
        <div class="{{ b5_top_container }}">
          {{ rpprac_home_differentiation ?: page.home_differentiation }}
        </div>
      </section>
    {% endif %}

    {% if rpprac_home_method or page.home_method %}
      <section class="rpprac-home-section rpprac-home-section--method">
        <div class="{{ b5_top_container }}">
          {{ rpprac_home_method ?: page.home_method }}
        </div>
      </section>
    {% endif %}

    {% if rpprac_home_local or page.home_local %}
      <section class="rpprac-home-section rpprac-home-section--local">
        <div class="{{ b5_top_container }}">
          {{ rpprac_home_local ?: page.home_local }}
        </div>
      </section>
    {% endif %}

    {% if rpprac_home_contact or page.home_contact %}
      <section class="rpprac-home-section rpprac-home-section--contact">
        <div class="{{ b5_top_container }}">
          {{ rpprac_home_contact ?: page.home_contact }}
        </div>
      </section>
    {% endif %}

    {% if page.content %}
      <section class="rpprac-home-section rpprac-home-section--content">
        <div class="{{ b5_top_container }}">
          {{ page.content }}
        </div>
      </section>
    {% endif %}
  </main>

  {% if page.footer %}
    <footer role="contentinfo" class="{{ footer_classes }}"{{ footer_attributes }}>
      <div class="{{ b5_top_container }}">
        {{ page.footer }}
        {% if rpprac_social_links %}
          <div class="rpprac-social-links" aria-label="{{ 'Social links'|t }}">
            {% for key, url in rpprac_social_links %}
              <a href="{{ url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ key|capitalize }}">
                <img src="{{ rpprac_base_path ~ '/' ~ rpprac_theme_path ~ '/icons/' ~ key ~ '.svg' }}" onerror="this.onerror=null;this.src='https://cdn.simpleicons.org/{{ key }}';" alt="{{ key|capitalize }}">
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </footer>
  {% endif %}

  <a class="rpprac-back-to-top" href="#top" aria-label="{{ 'Back to top'|t }}">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <path d="M6 15 L12 8 L18 15" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</div>

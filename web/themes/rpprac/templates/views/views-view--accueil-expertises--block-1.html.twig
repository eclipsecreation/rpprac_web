{#
/**
 * @file
 * Theme override for the home expertise view block.
 */
#}
<div{{ attributes.addClass('view', 'view-accueil-expertises-home') }}>
  {% if title %}
    <div class="rpprac-section-heading">
      <h2 class="rpprac-section-heading__title">{{ title }}</h2>
    </div>
  {% endif %}

  {% if header %}
    <div class="rpprac-section-heading__intro">
      {{ header }}
    </div>
  {% endif %}

  <div class="rpprac-expertise-grid">
    {{ rows }}
  </div>

  {% if footer %}
    <div class="rpprac-section-footer">
      {{ footer }}
    </div>
  {% endif %}
</div>
{#
/**
 * @file
 * Theme override for an expertise card on the homepage.
 */
#}
<article class="agecomevent-expertise-card">
  {% if fields.field_hero_image is defined %}
    <div class="agecomevent-expertise-card__media">
      {{ fields.field_hero_image.content }}
    </div>
  {% endif %}

  <div class="agecomevent-expertise-card__body">
    {% if fields.title is defined %}
      <h3 class="agecomevent-expertise-card__title">{{ fields.title.content }}</h3>
    {% endif %}

    {% if fields.field_chapo is defined %}
      <div class="agecomevent-expertise-card__text">{{ fields.field_chapo.content }}</div>
    {% endif %}
  </div>
</article>
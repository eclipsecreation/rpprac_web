{#
/**
 * @file
 * Theme override for the home targets custom block.
 */
#}
{% set section_title = content.field_section_title|render|striptags|trim %}
<div{{ attributes.addClass('agecomevent-targets-block') }}>
  <div class="agecomevent-targets-block__content">
    {% if section_title %}
      <h2 class="agecomevent-targets-block__title">{{ section_title }}</h2>
    {% endif %}

    {% if content.field_section_intro %}
      <div class="agecomevent-targets-block__intro">{{ content.field_section_intro }}</div>
    {% endif %}

    {% if content.field_section_items %}
      <div class="agecomevent-targets-block__items">{{ content.field_section_items }}</div>
    {% endif %}
  </div>

  {% if content.field_section_image %}
    <div class="agecomevent-targets-block__media">{{ content.field_section_image }}</div>
  {% endif %}
</div>
{#
/**
 * @file
 * Theme override for the home final contact custom block.
 */
#}
{% set section_title = content.field_section_title|render|striptags|trim %}
<div{{ attributes.addClass('rpprac-contact-block') }}>
  <div class="rpprac-contact-block__content">
    {% if section_title %}
      <h2 class="rpprac-contact-block__title">{{ section_title }}</h2>
    {% endif %}

    {% if content.field_section_text %}
      <div class="rpprac-contact-block__text">{{ content.field_section_text }}</div>
    {% endif %}

    {% if content.field_primary_cta or content.field_secondary_cta %}
      <div class="rpprac-contact-block__actions">
        {% if content.field_primary_cta %}
          <div class="rpprac-contact-block__action rpprac-contact-block__action--primary">{{ content.field_primary_cta }}</div>
        {% endif %}
        {% if content.field_secondary_cta %}
          <div class="rpprac-contact-block__action rpprac-contact-block__action--secondary">{{ content.field_secondary_cta }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if content.field_section_image %}
    <div class="rpprac-contact-block__media">{{ content.field_section_image }}</div>
  {% endif %}
</div>
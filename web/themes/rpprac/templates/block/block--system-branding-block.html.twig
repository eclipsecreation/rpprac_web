{% extends "block.html.twig" %}
{#
/**
 * @file
 * Theme override for the system branding block.
 */
#}
{% block content %}
  {% set branding_logo = agecomevent_logo_path ?: site_logo ?: file_url(active_theme_path() ~ '/logo.svg') %}
  <div class="navbar-brand d-flex align-items-center py-2">
    {% if branding_logo %}
      <a href="{{ path('<front>') }}" title="{{ 'Home'|t }}" rel="home" class="site-logo d-inline-flex align-items-center flex-shrink-0">
        <img src="{{ branding_logo }}" alt="{{ 'Home'|t }}" fetchpriority="high" />
      </a>
    {% endif %}

    {% if site_name or site_slogan %}
      <div class="agecomevent-brand-text">
        {% if site_name %}
          <a href="{{ path('<front>') }}" title="{{ 'Home'|t }}" rel="home" class="site-title">
            {{ site_name }}
          </a>
        {% endif %}

        {% if site_slogan %}
          <div class="site-slogan">{{ site_slogan }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endblock %}
{#
/**
 * @file
 * Theme override for the home local anchor custom block.
 */
#}
{% set section_title = content.field_section_title|render|striptags|trim %}
<div{{ attributes.addClass('rpprac-local-block') }}>
  <div class="rpprac-local-block__content">
    {% if section_title %}
      <h2 class="rpprac-local-block__title">{{ section_title }}</h2>
    {% endif %}

    {% if content.field_section_text %}
      <div class="rpprac-local-block__text">{{ content.field_section_text }}</div>
    {% endif %}
  </div>

  {% if content.field_section_image %}
    <div class="rpprac-local-block__media">{{ content.field_section_image }}</div>
  {% endif %}
</div>
<?php

declare(strict_types=1);

use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\views\Entity\View;

/**
 * Returns all available view displays for the embedded view selector.
 */
function rpprac_tools_view_block_allowed_values(FieldStorageDefinitionInterface $definition, ?FieldableEntityInterface $entity = NULL, &$cacheable = TRUE): array {
  $values = [];
  $view_storage = \Drupal::entityTypeManager()->getStorage('view');

  /** @var \Drupal\views\Entity\View[] $views */
  $views = $view_storage->loadMultiple();
  uasort($views, static function (View $left, View $right): int {
    return strnatcasecmp((string) $left->label(), (string) $right->label());
  });

  foreach ($views as $view) {
    if (!$view->status()) {
      continue;
    }

    $displays = $view->get('display') ?? [];
    foreach ($displays as $display_id => $display) {
      if ($display_id === 'default') {
        continue;
      }

      $display_plugin = $display['display_plugin'] ?? '';
      if ($display_plugin !== 'block') {
        continue;
      }

      $display_title = $display['display_title'] ?? $display_id;
      $label = sprintf('%s - %s', $view->label(), $display_title);
      $values[$view->id() . ':' . $display_id] = $label;
    }
  }

  return $values;
}